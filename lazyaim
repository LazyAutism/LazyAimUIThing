-- Hide animation: slides frame UP off screen, returns to its CURRENT position (not hardcoded)
local function getOffscreenPos()
    -- Push the frame completely above the top of the screen
    local frameH = frame.AbsoluteSize.Y
    return UDim2.new(
        frame.Position.X.Scale, frame.Position.X.Offset,
        0, -(frameH + 20)
    )
end

local function showUI()
    uiVisible = true
    local returnPos = frame.Position -- wherever it currently is (or was)
    frame.Visible = true
    if hideAnimation then
        TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = returnPos
        }):Play()
    end
end

local function hideUI()
    uiVisible = false
    if hideAnimation then
        local offPos = getOffscreenPos()
        local tween = TweenService:Create(frame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = offPos
        })
        tween:Play()
        tween.Completed:Connect(function()
            if not uiVisible then frame.Visible = false end
        end)
    else
        frame.Visible = false
    end
end

