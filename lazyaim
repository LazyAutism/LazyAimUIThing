--========================================================--
--===================== AIM LOGIC ========================--
--========================================================--

local function clearLock()
    lockEnabled = false
    lockedPart = nil
    clearHighlight()
    if deathConn then deathConn:Disconnect() deathConn = nil end
    if ancestryConn then ancestryConn:Disconnect() ancestryConn = nil end
    if healthConn then healthConn:Disconnect() healthConn = nil end
end

local function getAimPart(model)
    if aimHead then
        return model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
    end
    return model:FindFirstChild("HumanoidRootPart")
end

local function validModel(model)
    if not model:IsA("Model") or model.Name == player.Name then return false end
    local targetPlayer = Players:GetPlayerFromCharacter(model)
    if isWhitelisted(targetPlayer) then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local isPlayer = (targetPlayer ~= nil)
    if filterIndex == 2 and not isPlayer then return false end
    if filterIndex == 3 and (not isPlayer or targetPlayer.Team == player.Team) then return false end
    if filterIndex == 4 and (not isPlayer or targetPlayer.Team ~= player.Team) then return false end
    if filterIndex == 5 and isPlayer then return false end
    return true
end

local function getMouseScreenPos()
    return UIS:GetMouseLocation()
end

local function worldToScreen(pos)
    local sp, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), onScreen
end

-- Wall check: returns true if there is a clear line of sight from camera to part
-- mode 1 = true direct: solid/opaque walls block (CanCollide must be true and transparency < 0.5)
-- mode 2 = direct: only fully opaque non-transparent parts block (transparency == 0 and CanCollide)
local function hasLineOfSight(part)
    if not player.Character then return false end
    local origin = Camera.CFrame.Position
    local direction = (part.Position - origin)
    local dist = direction.Magnitude
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { player.Character, Camera }
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(origin, direction.Unit * dist * 0.98, params)
    if not result then return true end -- nothing in the way
    local hit = result.Instance
    if preferDirectMode == 1 then
        -- true direct: any collidable part blocks
        return not (hit and hit.CanCollide and hit.Transparency < 0.5)
    else
        -- direct: only fully opaque collidable parts block
        return not (hit and hit.CanCollide and hit.Transparency == 0)
    end
end

local function findTarget(forceMode)
    local best, bestDist = nil, math.huge
    local useMode = forceMode or modeIndex
    local candidates = {}

    for _, model in ipairs(workspace:GetDescendants()) do
        if validModel(model) then
            local part = getAimPart(model)
            if part then
                table.insert(candidates, { part = part, model = model })
            end
        end
    end

    -- If preferDirect is on, partition into visible and non-visible
    local visibleCandidates, hiddenCandidates = {}, {}
    if preferDirect then
        for _, c in ipairs(candidates) do
            if hasLineOfSight(c.part) then
                table.insert(visibleCandidates, c)
            else
                table.insert(hiddenCandidates, c)
            end
        end
    else
        visibleCandidates = candidates
    end

    local function searchList(list)
        local found = nil
        local foundDist = math.huge
        for _, c in ipairs(list) do
            local part = c.part
            if useMode == 1 then
                -- Direct mode: raycast from camera through mouse cursor
                local mpos = getMouseScreenPos()
                local ray = Camera:ViewportPointToRay(mpos.X, mpos.Y)
                local rparams = RaycastParams.new()
                if player.Character then rparams.FilterDescendantsInstances = { player.Character } end
                rparams.FilterType = Enum.RaycastFilterType.Exclude
                local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, rparams)
                if result and result.Instance and result.Instance:IsDescendantOf(c.model) then
                    return part
                end
            elseif useMode == 2 then
                -- Nearest to cursor
                local sp, onScreen = worldToScreen(part.Position)
                if onScreen then
                    local d = (sp - getMouseScreenPos()).Magnitude
                    if d < foundDist then foundDist, found = d, part end
                end
            elseif useMode == 3 then
                -- Nearest (distance from player)
                if player.Character then
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d = (part.Position - hrp.Position).Magnitude
                        if d < foundDist then foundDist, found = d, part end
                    end
                end
            elseif useMode == 4 then
                -- Nearest to screen center
                local sp, onScreen = worldToScreen(part.Position)
                if onScreen then
                    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local d = (sp - center).Magnitude
                    if d < foundDist then foundDist, found = d, part end
                end
            end
        end
        return found
    end

    -- Try visible first, fall back to hidden if preferDirect is on
    local result = searchList(visibleCandidates)
    if not result and preferDirect and #hiddenCandidates > 0 then
        result = searchList(hiddenCandidates)
    end
    return result
end

-- Auto-relock helper: waits a tick then tries to find new target
local function doAutoRelock()
    if not autoRelock then return end
    task.defer(function()
        local nextT = findTarget(2)
        if nextT then lock(nextT) end
    end)
end

-- Forward declare lock so clearLock can reference it if needed via doAutoRelock
function lock(part)
    if not part then return end
    clearLock()
    lockedPart = part
    lockEnabled = true
    applyHighlight(part.Parent)

    local model = part.Parent
    local hum = model:FindFirstChildOfClass("Humanoid")

    if hum then
        -- Primary: Died event
        deathConn = hum.Died:Connect(function()
            clearLock()
            doAutoRelock()
        end)
        -- Secondary: Health monitor — catches ragdoll deaths where Died may fire late/not at all
        healthConn = hum:GetPropertyChangedSignal("Health"):Connect(function()
            if hum.Health <= 0 then
                if deathConn then deathConn:Disconnect() deathConn = nil end
                if healthConn then healthConn:Disconnect() healthConn = nil end
                clearLock()
                doAutoRelock()
            end
        end)
    end

    -- Ancestry watch: catches character removal (respawn, leaving, etc.)
    ancestryConn = part.AncestryChanged:Connect(function(_, p)
        if not p then
            clearLock()
            doAutoRelock()
        end
    end)
end

